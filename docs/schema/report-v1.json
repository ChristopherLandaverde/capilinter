{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristopherLandaverde/capilinter/blob/main/docs/schema/report-v1.json",
  "title": "CAPILinter inspect report, schema version 1",
  "description": "Output of `capilinter inspect --json` and the `audit_payload` MCP tool.",
  "type": "object",
  "required": ["schema_version", "file", "passed", "batch_issues", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "file": {"type": "string", "description": "The path given, or <payload_json> for inline JSON."},
    "passed": {"type": "boolean"},
    "error": {"type": "string", "description": "Present only when the payload has no events."},
    "batch_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "event_name", "event_id", "valid", "issues", "emq_estimate"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "event_name": {},
          "event_id": {},
          "valid": {"type": "boolean"},
          "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
          "emq_estimate": {
            "type": "object",
            "required": ["score", "grade", "matched_parameters", "missing_parameters", "recommendations"],
            "additionalProperties": false,
            "properties": {
              "score": {"type": "number", "minimum": 0, "maximum": 10},
              "grade": {"enum": ["EXCELLENT", "GOOD", "FAIR", "POOR"]},
              "matched_parameters": {"type": "array", "items": {"type": "string"}},
              "missing_parameters": {"type": "array", "items": {"type": "string"}},
              "recommendations": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["severity", "code", "message", "field", "fix", "source"],
      "additionalProperties": false,
      "properties": {
        "severity": {"enum": ["ERROR", "WARNING"]},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "message": {"type": "string"},
        "field": {"type": "string"},
        "fix": {"type": "string", "minLength": 1},
        "source": {"type": "string", "pattern": "^https://developers\\.facebook\\.com/"}
      }
    }
  }
}
